# Copy to .env and fill in. Never commit .env.

# --- App ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (docker compose starts Postgres on 5432) ------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/profitcosmos
DATABASE_POOL_MAX=10

# --- Auth --------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Tenancy (single tenant for now) -----------------------------------
DEFAULT_ORGANIZATION_SLUG=profitcosmos-omega

# --- Public lead form ----------------------------------------------------
# Extra website origins allowed to post to /api/public/leads (comma-separated). APP_URL is always allowed.
PUBLIC_FORM_ORIGINS=
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10

# --- Email -------------------------------------------------------------
# console = log only (default); smtp = send via SMTP (Mailpit in dev: http://localhost:8025)
EMAIL_PROVIDER=console
EMAIL_FROM="ProfitCosmos Omega <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- AI qualification agent (Phase 3) ------------------------------------
# Kill switch: false = no model is ever called (chat still stores messages for staff).
# The agent also stays off until its prompts are approved (config/prompts, status: approved).
AI_ENABLED=false
ANTHROPIC_API_KEY=
# Conversation replies, and the guardrail classifier / extraction model.
LLM_MODEL_CONVERSATION=claude-opus-5-5
LLM_MODEL_EXTRACTION=claude-sonnet-5-5
# Daily token ceiling for the organisation (input + output, UTC day).
AI_DAILY_TOKEN_LIMIT=500000

# --- Seed (pnpm db:seed) -------------------------------------------------
SEED_ORGANIZATION_NAME="ProfitCosmos Omega Academy"
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=Owner
# At least 12 characters
SEED_OWNER_PASSWORD=
